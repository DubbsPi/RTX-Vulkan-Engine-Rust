#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"


layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba8) uniform image2D outputImage;

layout(binding = 2, set = 0) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    float time;
} cam;


layout(location = 0) rayPayloadEXT vec3 hitColor;


void main() {
    vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    vec2 uv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 origin = cam.viewInverse * vec4(0, 0, 0, 1);
    vec4 target = cam.projInverse * vec4(ndc.x, ndc.y, 1, 1);
    vec3 rayDirView = normalize(target.xyz / target.w);
    vec4 direction = cam.viewInverse * vec4(rayDirView, 0);

    hitColor = vec3(0, 0, 0);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,
        0,
        0,
        origin.xyz,
        0.001,
        direction.xyz,
        10000.0,
        0
    );
    

    // Aces
    hitColor = (hitColor * (2.51 * hitColor + 0.03)) / (hitColor * (2.43 * hitColor + 0.59) + 0.14);
    hitColor = pow(clamp(hitColor, 0.0, 1.0), vec3(1.0 / 2.2));

    // Dithering
    float dither = bayerDither(gl_LaunchIDEXT.xy);
    hitColor += dither * 0.00392156862;

    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(hitColor, 1.0));
}