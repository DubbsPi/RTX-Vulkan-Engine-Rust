#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"


layout(binding = 2, set = 0, scalar) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    float time;
    vec3 cameraPos;

    uint numPlanets;
    uint numStars;
} cam;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 3, set = 0, scalar) buffer ObjectDescs {ObjectDesc descs[];};
layout(binding = 4, set = 0, scalar) buffer Materials {Material mats[];};
layout(binding = 5, set = 0, scalar) buffer MaterialIDs {uint materialIds[];};
layout(binding = 6, set = 0, rgba32f) uniform image2D accumImage;
layout(binding = 7, set = 0, scalar) buffer Planets {PlanetRenderInfo planets[];} planetBuffer;
layout(binding = 8, set = 0, scalar) buffer Stars {StarRenderInfo stars[];} starBuffer;
layout(binding = 9, set = 0) uniform sampler2D textures[];


layout(push_constant) uniform PushConstants {
    uint frameIndex;
    uint accumulatedSamples;
} pc;


layout(location = 0) rayPayloadEXT uint dummyPayload;
layout(location = 1) rayPayloadEXT bool shadowed;

layout(location = 0) hitObjectAttributeEXT vec2 hitAttribs;


void main() {
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);

    uint rngState = randInt(gl_LaunchIDEXT.xy, gl_LaunchSizeEXT.xy, pc.frameIndex);
    vec2 jitter = vec2(rand(rngState), rand(rngState)) - 0.5;
    vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5) + jitter;

    vec2 screenUv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = screenUv * 2.0 - 1.0;

    vec4 target = normalize(cam.projInverse * vec4(ndc.x, ndc.y, 1, 1));
    vec3 rayDirView = normalize(target.xyz / target.w);


    vec3 accumulatedColor = vec3(0);
    vec3 throughput = vec3(1);

    // Always zero to start since all geometry is camera relative
    vec3 rayOrigin = vec3(0);
    vec3 rayDirection = normalize(cam.viewInverse * vec4(rayDirView, 0)).xyz;
    float hitDepth;

    int heroChannel = -1;
    bool prevNEE = false;
    float prevBsdfPdf = 0.0;
    float prevSelSum = 0.0;
    bool hadSurface = false;
    int glassChain = 0;
    float pNEE = 1.0;


    for (int bounce = 0; bounce < MAX_BOUNCES; bounce++) {
        hitObjectEXT hit;
        hitObjectTraceRayEXT(
            hit, topLevelAS, gl_RayFlagsNoneEXT, 0xFF,
            0, 0, 0,
            rayOrigin, 0.00001, rayDirection, 100000000.0,
            0
        );

        bool isMiss = hitObjectIsMissEXT(hit);

        int  modelIndex = -1;
        uint primId = 0u, matId = 0u;
        bool isDelta = false, doNEE = false;
        uint hint = 0u;

        if (!isMiss) {
            modelIndex = hitObjectGetInstanceCustomIndexEXT(hit) + hitObjectGetGeometryIndexEXT(hit);
            primId = uint(hitObjectGetPrimitiveIndexEXT(hit));
            matId = materialIds[descs[modelIndex].materialId + primId];

            isDelta = (mats[matId].alphaMode == 2 && mats[matId].transmission > 0.0);

            float lum  = max(throughput.r, max(throughput.g, throughput.b));
            pNEE = clamp(lum * 2.0, 0.1, 1.0);
            doNEE = !isDelta && cam.numStars > 0 && rand(rngState) < pNEE && bounce < MAX_NEE_TESTS;

            hint = (1u << 6) | ((matId & 15u) << 2) | (isDelta ? 2u : 0u) | (doNEE ? 1u : 0u);
        }

        reorderThreadEXT(hit, hint, 4);

        
        if (isMiss) {
            vec3 sky = vec3(0);
            float nearestPlanetGround = 1e30;
            int nearestPlanetIndex = -1;
            for (uint i = 0; i < cam.numPlanets; i++) {
                PlanetRenderInfo pinfo = planetBuffer.planets[i];

                SphereRayParams groundParams = sphereRayParams(
                    rayDirection, pinfo.radius + pinfo.cameraDist,
                    pinfo.planetUp, pinfo.radius
                );
                vec2 groundHits = solveSphereHits(groundParams);
                float groundDistance = groundHits.x > 0.0 ? groundHits.x : groundHits.y;
                if (groundDistance > 0.0 && groundDistance < nearestPlanetGround) {
                    nearestPlanetGround = groundDistance;
                    nearestPlanetIndex = int(i);
                }
            }

            for (uint i = 0; i < cam.numPlanets; i++) {
                PlanetRenderInfo pinfo = planetBuffer.planets[i];
                vec3 planetPos = pinfo.planetUp * (pinfo.radius + pinfo.cameraDist);
                vec3 lightDir = vec3(0);
                vec3 irradiance = vec3(0);
                vec3 lightColorSky = vec3(1);

                if (pinfo.parentStar >= 0) {
                    StarRenderInfo sinfo = starBuffer.stars[pinfo.parentStar];
                    starLightAtPoint(sinfo, planetPos, lightDir, irradiance);
                }

                float lightMag = max(irradiance.r, max(irradiance.g, irradiance.b));
                vec3 lightColorNorm = lightMag > 1e-6? irradiance / lightMag : vec3(0);

                sky += getPlanetSky(rayDirection, lightDir, lightColorNorm, lightMag, pinfo, rand(rngState), nearestPlanetGround, int(i) == nearestPlanetIndex);
            }

            bool hitPlanetGround = nearestPlanetIndex >= 0;
            if (!hitPlanetGround) {
                vec3 mappedColor = (sky * (2.51 * sky + 0.03)) / (sky * (2.43 * sky + 0.59) + 0.14);
                mappedColor = pow(clamp(mappedColor, 0.0, 1.0), vec3(0.454545455));
                float starVisibility = clamp(1.0 - luminance(mappedColor) * 4.0, 0.0, 1.0);
                sky += starField(rayDirection) * starVisibility;
            }
            
            // Stars
            for (uint i = 0; i < cam.numStars; i++) {
                StarRenderInfo sinfo = starBuffer.stars[i];
                vec3 starPos = starPositionCamRelative(sinfo);
                vec2 sh = intersectSphere(rayOrigin, rayDirection, starPos, sinfo.radius);
                if (!hitPlanetGround && (sh.x > 0.0 || sh.y > 0.0)) {
                    vec3 Le = sinfo.color * min(sinfo.luminosity, MAX_STAR_CAMERA_BRIGHTNESS);
                    for (uint p = 0; p < cam.numPlanets; p++) {
                        Le *= atmosphereTransmittance(rayOrigin, rayDirection, planetBuffer.planets[p]);
                    }
                    float misW = 1.0;

                    if (bounce > 0) {
                        vec3 dirTo, E;
                        starLightAtPoint(sinfo, rayOrigin, dirTo, E);
                        float omega = diskSolidAngle(sinfo.radius, sinfo.cameraDist);
                        Le = E / omega;

                        if (prevNEE) {
                            float wj = max(E.r, max(E.g, E.b));
                            float pLight = (wj / prevSelSum) / omega;
                            misW = balanceHeuristic(prevBsdfPdf, pLight);
                        }
                    }
                    if (glassChain == 1) misW *= (1.0 - GLASS_NEE_BLEND);
                    sky += Le * misW;
                }
            }
            accumulatedColor += throughput * sky;
            break;
        }


        float tHit = hitObjectGetRayTMaxEXT(hit);
        mat4x3 worldToObject = hitObjectGetWorldToObjectEXT(hit);
        hitObjectGetAttributesEXT(hit, 0);
        vec3 bary = vec3(1.0 - hitAttribs.x - hitAttribs.y, hitAttribs.x, hitAttribs.y);

        ObjectDesc obj = descs[modelIndex];
        Indices  indices  = Indices(obj.indexAddress);
        Vertices vertices = Vertices(obj.vertexAddress);
        uint i0 = indices.i[3 * primId];
        uint i1 = indices.i[3 * primId + 1];
        uint i2 = indices.i[3 * primId + 2];

        vec3 p0 = vertices.vert[i0].p;
        vec3 p1 = vertices.vert[i1].p;
        vec3 p2 = vertices.vert[i2].p;
        vec3 viewNormal = vertices.vert[i0].n * bary.x + vertices.vert[i1].n * bary.y + vertices.vert[i2].n * bary.z;
        vec3 normal = normalize(vec3(viewNormal * worldToObject));
        vec2 uv = vertices.vert[i0].uv * bary.x + vertices.vert[i1].uv * bary.y + vertices.vert[i2].uv * bary.z;

        Material mat = mats[matId];
        float u = rand(rngState);


        // Texturing and materials
        vec3 albedo = mat.albedo;
        accumulatedColor += throughput * mat.emission;
        if (mat.albedoTextureIndex >= 0) {
            float textureLodLevel = log2(max(tHit, 1.0));
            albedo = textureLod(textures[nonuniformEXT(mat.albedoTextureIndex)], uv, textureLodLevel).rgb;
        }


        // Special normal calculation for geometric offsets
        vec3 hitPos = rayOrigin + rayDirection * tHit;
        float epsilon = max(1e-6, length(hitPos) * 1e-7);
        vec3 geometricNormal = normalize(vec3(cross(p1 - p0, p2 - p0) * worldToObject));

        bool frontFace = dot(geometricNormal, rayDirection) < 0.0;
        if (dot(geometricNormal, rayDirection) > 0.0) geometricNormal = -geometricNormal;
        
        if (!frontFace) {
            throughput *= exp(-mat.absorptionColor * tHit);
        }

        vec3 N = frontFace ? normal : -normal;
        vec3 V = -rayDirection;
        float NdotV = max(dot(N, V), 1e-4);


        vec3 F0 = mix(vec3(0.08 * mat.specular), albedo, mat.metallic);
        vec2 xi = vec2(rand(rngState), rand(rngState));
        vec3 newDir, bsdfWeight;


        float coatF0 = 0.04;
        float coatFresnel = mat.clearcoat * fresnelSchlick1(NdotV, coatF0);

        float baseAvailable = 1.0 - coatFresnel;
        float specProb = clamp(mix(fresnelSchlick(NdotV, F0).x, 1.0, mat.metallic), 0.01, 0.99) * baseAvailable;
        float coatProb = coatFresnel;
        float diffProb = max(0.0, baseAvailable - specProb);

        float invTotal = 1.0 / max(specProb + coatProb + diffProb, 1e-4);
        specProb *= invTotal; coatProb *= invTotal; diffProb *= invTotal;


        bool didNEE = false;
        float selSum = 0.0;
        
        // NEE nearest star
        if (doNEE) {
            uint chosen = 0;
            float chosenW = 0.0;
            for (uint i = 0; i < cam.numStars; i++) {
                float w = starSelWeight(starBuffer.stars[i], hitPos);
                selSum += w;
                if (rand(rngState) * selSum < w) { chosen = i; chosenW = w; }
            }

            if (selSum > 1e-6 && chosenW > 0.0) {
                didNEE = true;
                float pSel = chosenW / selSum;

                StarRenderInfo s = starBuffer.stars[chosen];
                vec3 starDir, E;
                starLightAtPoint(s, hitPos, starDir, E);
                for (uint p = 0; p < cam.numPlanets; p++) {
                    E *= atmosphereTransmittance(hitPos, starDir, planetBuffer.planets[p]);
                }
                float omega = diskSolidAngle(s.radius, s.cameraDist);
                vec3 L = sampleStarDisk(starDir, s.radius, s.cameraDist, rngState);

                float NdotL = dot(N, L);
                if (NdotL > 0.0 && dot(geometricNormal, L) > 0.0) {
                    bool  visible  = false;
                    bool  viaGlass = false;
                    vec3  glassT   = vec3(1.0);
                    vec3  sOrigin  = hitPos + geometricNormal * epsilon;

                    for (int hop = 0; hop <= MAX_GLASS_HOPS; hop++) {
                        hitObjectEXT sh;
                        hitObjectTraceRayEXT(
                            sh, topLevelAS, gl_RayFlagsNoneEXT, 0xFF,
                            0, 0, 1,
                            sOrigin, 0.00001, L, 100000000.0,
                            0
                        );

                        if (hitObjectIsMissEXT(sh)) { visible = true; break; }

                        int  sModel = hitObjectGetInstanceCustomIndexEXT(sh) + hitObjectGetGeometryIndexEXT(sh);
                        uint sPrim  = uint(hitObjectGetPrimitiveIndexEXT(sh));
                        uint sMatId = materialIds[descs[sModel].materialId + sPrim];
                        Material sMat = mats[sMatId];

                        bool sGlass = (sMat.alphaMode == 2 && sMat.transmission > 0.0);
                        if (!sGlass || hop == MAX_GLASS_HOPS) break;

                        float sT = hitObjectGetRayTMaxEXT(sh);
                        mat4x3 sW2O = hitObjectGetWorldToObjectEXT(sh);
                        ObjectDesc sObj = descs[sModel];
                        Indices  sIdx  = Indices(sObj.indexAddress);
                        Vertices sVert = Vertices(sObj.vertexAddress);
                        vec3 q0 = sVert.vert[sIdx.i[3 * sPrim]].p;
                        vec3 q1 = sVert.vert[sIdx.i[3 * sPrim + 1]].p;
                        vec3 q2 = sVert.vert[sIdx.i[3 * sPrim + 2]].p;
                        vec3 gN = normalize(vec3(cross(q1 - q0, q2 - q0) * sW2O));

                        float cosI = abs(dot(gN, L));
                        if (dot(gN, L) > 0.0) {
                            glassT *= exp(-sMat.absorptionColor * sT);
                        }
                        float iorS = sMat.ior;
                        vec3 F0g  = vec3(pow((iorS - 1.0) / (iorS + 1.0), 2.0));

                        vec3 sAlbedo = sMat.albedo;
                        if (sMat.albedoTextureIndex >= 0) {
                            float textureLodLevel = log2(max(tHit, 1.0));
                            sAlbedo = textureLod(textures[nonuniformEXT(sMat.albedoTextureIndex)], uv, textureLodLevel).rgb;
                        }
                        glassT *= (1.0 - fresnelSchlick(cosI, F0g).x) * sAlbedo;

                        viaGlass = true;
                        vec3 sHit = sOrigin + L * sT;
                        sOrigin = sHit + L * max(1e-6, length(sHit) * 1e-7);
                    }

                    if (visible) {
                        float pBsdf;
                        vec3 f = evalBSDF(N, V, L, mat, albedo, F0, baseAvailable, specProb, coatProb, diffProb, pBsdf);
                        vec3 base = throughput * f * NdotL * (E / pSel);

                        if (viaGlass) {
                            accumulatedColor += base * glassT * (GLASS_NEE_BLEND / pNEE);
                        } else {
                            float w = balanceHeuristic(pSel / omega, pBsdf);
                            accumulatedColor += base * w;
                        }
                    }
                }
            }
        }

        if (!isDelta) {hadSurface = true; glassChain = 0;}


        if (mat.alphaMode == 2 && mat.transmission > 0.0) {
            float iorC = mat.ior;

            if (mat.dispersion > 0.0) {
                if (heroChannel < 0) {
                    heroChannel = min(int(rand(rngState) * 3.0), 2);
                    vec3 mask = vec3(0.0);
                    mask[heroChannel] = 1.0;
                    throughput *= 3.0 * mask;
                }
                float halfSpread = (mat.ior - 1.0) * 0.025 * mat.dispersion;
                iorC = mat.ior + halfSpread * float(heroChannel - 1);
            }

            float eta = frontFace ? (1.0 / iorC) : iorC;
            vec3 F0d = vec3(pow((iorC - 1.0) / (iorC + 1.0), 2.0));
            float fresnel = fresnelSchlick(NdotV, F0d).x;

            vec3 refracted = refract(-V, N, eta);
            bool tir = dot(refracted, refracted) < 1e-8;

            if (tir || rand(rngState) < fresnel) {
                newDir = reflect(-V, N);
                rayOrigin = hitPos + N * epsilon;
            } else {
                newDir = normalize(refracted);
                rayOrigin = hitPos - N * epsilon;
            }
            bsdfWeight = albedo;
        } else if (u < coatProb) {
            vec3 T, B;
            buildTangentBasis(N, T, B);
            vec3 Ve = normalize(vec3(dot(V, T), dot(V, B), dot(V, N)));
            vec3 Ne = sampleGGXVNDF(Ve, max(mat.clearcoatRoughness, 0.0001), xi);
            vec3 H = normalize(Ne.x * T + Ne.y * B + Ne.z * N);
            newDir = reflect(-V, H);

            float NdotL = dot(N, newDir);
            if (NdotL <= 0.0) {
                bsdfWeight = vec3(0.0);
            } else {
                float Fc = mat.clearcoat * fresnelSchlick1(max(dot(V, H), 0.0), coatF0);
                float G = geometrySmithGGX(NdotV, NdotL, mat.clearcoatRoughness);
                float G1v = geometrySmithGGX(NdotV, 1.0, mat.clearcoatRoughness);
                bsdfWeight = vec3(Fc * (G / max(G1v, 1e-4)));
            }
            bsdfWeight /= coatProb;
            rayOrigin = hitPos + N * epsilon;
        }
        else if (u < coatProb + specProb) {
            vec3 T, B;
            buildTangentBasis(N, T, B);
            vec3 Ve = normalize(vec3(dot(V, T), dot(V, B), dot(V, N)));
            vec3 Ne = sampleGGXVNDF(Ve, max(mat.roughness, 0.0001), xi);
            vec3 H = normalize(Ne.x * T + Ne.y * B + Ne.z * N);
            newDir = reflect(-V, H);

            float NdotL = dot(N, newDir);
            if (NdotL <= 0.0) {
                bsdfWeight = vec3(0.0);
            } else {
                vec3 F = fresnelSchlick(max(dot(V, H), 0.0), F0);
                float G = geometrySmithGGX(NdotV, NdotL, mat.roughness);
                float G1v = geometrySmithGGX(NdotV, 1.0, mat.roughness);
                bsdfWeight = baseAvailable * F * (G / max(G1v, 1e-4));
            }
            bsdfWeight /= specProb;
            rayOrigin = hitPos + N * epsilon;
        }
        else {
            newDir = sampleCosineHemisphere(xi, N);
            vec3 diffuseColor = albedo * (1.0 - mat.metallic);
            vec3 kd = 1.0 - fresnelSchlick(NdotV, F0);
            vec3 sheenAdd = mat.sheenColor * mat.sheen * pow(1.0 - NdotV, 5.0);
            
            bsdfWeight = baseAvailable * (diffuseColor * kd + sheenAdd);
            bsdfWeight /= max(diffProb, 1e-4);
            rayOrigin = hitPos + N * epsilon;
        }

        throughput *= bsdfWeight;
        rayDirection = newDir;

        prevNEE = didNEE;
        if (didNEE) {
            prevSelSum = selSum;
            evalBSDF(N, V, newDir, mat, albedo, F0, baseAvailable, specProb, coatProb, diffProb, prevBsdfPdf);
        }

        if (bounce > 1) {
            float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 1.0);
            if (rand(rngState) > p) break;
            throughput /= p;
        }

        if (bounce == 0) hitDepth = tHit;
    }


    vec3 historyColor = accumulatedColor;
    if (pc.accumulatedSamples > 0) {
        vec4 history = imageLoad(accumImage, pixelCoord);
        historyColor = history.rgb;
    }

    // Running average
    float weight = 1.0 / float(min(pc.accumulatedSamples, MAX_ACCUMULATION) + 1);
    vec3 newAccum = mix(historyColor, accumulatedColor, weight);

    imageStore(accumImage, pixelCoord, vec4(newAccum, hitDepth));
}